{
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "jscpd": "^4.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "(npm run lint) && (npm run cpd)",
    "test": "vitest run src --no-file-parallelism --testTimeout=3000 --coverage",
    "cpd": "jscpd --config .jscpd.json src",
    "lint": "eslint src/**/*.[jt]s --fix"
  }
}
