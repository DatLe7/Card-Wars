{
  "threshold": 5,
  "minLines": 15,
  "minTokens": 150,
  "reporters": ["html", "console"],
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/coverage/**",
    "**/copypaste/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test/**"
  ],
  "absolute": true,
  "output": "copypaste"
}
