{
  "threshold": 3,
  "minLines": 10,
  "minTokens": 100,
  "reporters": ["html", "console"],
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/coverage/**",
    "**/copypaste/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test/**"
  ],
  "absolute": true,
  "output": "copypaste"
}
